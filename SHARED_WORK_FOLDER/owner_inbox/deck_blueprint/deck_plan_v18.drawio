        <mxCell id="v18-callout-ledger-0396" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#cc8800;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#663300;fontSize=6;" value="&lt;b&gt;LEDGER: ½&quot; HDG carriage bolts, back-blocked from&lt;/b&gt;&lt;br/&gt;&lt;b&gt;basement; ½&quot; HDG lag @ 18&quot; OC two-row staggered&lt;/b&gt;&lt;br/&gt;between connections (IRC R507.9.1.3). Wood-frame wall.&lt;br/&gt;Peel-and-stick + Z-flashing + kick-out at ends.&lt;br/&gt;DTT2Z lateral connectors (4× per IRC R507.9)." vertex="1">
          <mxGeometry height="66" width="220" x="1164" y="172" as="geometry" />
        </mxCell>
        <mxCell id="v18-callout-pier-0397" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0e0;strokeColor=#5a4030;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#5a4030;fontSize=6;" value="&lt;b&gt;PYLEX 50 HELICAL PIER + 10555 SADDLE&lt;/b&gt;&lt;br/&gt;10 piers total — 5 per girder line&lt;br/&gt;Pier spacing: 5&#39;-9&quot; (within DCA-6 limit of 8&#39;-2&quot;)&lt;br/&gt;¼&quot; cedar/HDPE shims each side in saddle&lt;br/&gt;Doubled 2×10 (3.0&quot; wide) fits 3.5&quot; saddle" vertex="1">
          <mxGeometry height="70" width="180" x="350" y="380" as="geometry" />
        </mxCell>
        <mxCell id="v18-callout-hangers-0398" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0e8;strokeColor=#882200;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#882200;fontSize=6;" value="&lt;b&gt;SIMPSON LUS210Z HDG — 100 total (order 110)&lt;/b&gt;&lt;br/&gt;25 @ ledger + 25 @ mid-girder S face + 25 @ mid-girder N face&lt;br/&gt;+ 25 @ outer-rim inboard face = 100 × 14 nails = 1,400 fasteners" vertex="1">
          <mxGeometry height="44" width="220" x="1164" y="482" as="geometry" />
        </mxCell>
        <mxCell id="v18-callout-decking-0399" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f4e8;strokeColor=#4a2a0a;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#4a2a08;fontSize=6;" value="&lt;b&gt;FIELD DECKING (v17)&lt;/b&gt;&lt;br/&gt;MoistureShield Vision 5.4&quot; composite&lt;br/&gt;Runs x-direction (∥ house)&lt;br/&gt;Two 11&#39;-9&quot; halves per row,&lt;br/&gt;butting center divider breaker&lt;br/&gt;Tiger Claw TC-G hidden fasteners&lt;br/&gt;33 rows total (≈72×12-ft boards ordered)" vertex="1">
          <mxGeometry height="90" width="200" y="188" as="geometry" />
        </mxCell>
        <mxCell id="v18-callout-changes-0400" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#cc6600;strokeWidth=2.0;opacity=100;dashed=0;fontColor=#4a2200;fontSize=7;" value="&lt;b&gt;v18 CHANGES vs. v17 — FOUNDATION / PIER LAYOUT ONLY&lt;/b&gt;&lt;br/&gt;• 8 piers → 10 piers (+2): one extra per girder line between existing positions&lt;br/&gt;• Pier spacing 7&#39;-8&quot; → 5&#39;-9&quot; (shorter spans, stronger bearing)&lt;br/&gt;• Girder splice recipe: was 16&#39;+8&#39; over 1 pier → now Ply1 11&#39;-6&quot;+11&#39;-6&quot; over center pier (x=11&#39;-6&quot;),&lt;br/&gt;  Ply2 5&#39;-9&quot;+11&#39;-6&quot;+5&#39;-9&quot; over piers 2 &amp; 4 (x=5&#39;-9&quot;, x=17&#39;-3&quot;)&lt;br/&gt;• Center pier (A3/B3 at x=11&#39;-6&quot;) aligns with center joist x-coordinate and breaker board centerline" vertex="1">
          <mxGeometry height="80" width="400" x="248" y="40" as="geometry" />
        </mxCell>
        <mxCell id="v18-callout-heave-0401" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0e0;strokeColor=#cc4400;strokeWidth=1.8;opacity=100;dashed=0;fontColor=#8B0000;fontSize=6;" value="&lt;b&gt;SEASONAL HEAVE NOTE (Hollis): shallow precast blocks WILL heave ¼-½&quot; per cycle.&lt;/b&gt;&lt;br/&gt;This is a decorative/convenience step, NOT frost-depth founded.&lt;br/&gt;Homeowner has accepted this trade-off.&lt;br/&gt;Step is separate from and does not affect left-edge stair." vertex="1">
          <mxGeometry height="58" width="300" x="560" y="834" as="geometry" />
        </mxCell>
        <mxCell id="v18-callout-dca-0402" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0ff;strokeColor=#333388;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#333388;fontSize=6;" value="&lt;b&gt;DCA-6 TABLE 3A CHECK (bring to permit office):&lt;/b&gt;&lt;br/&gt;Doubled 2×10 SYP @ 8-ft joist span → max girder span 8&#39;-2&quot;&lt;br/&gt;v18 pier spacing = 5&#39;-9&quot; — passes with ≈2&#39;-5&quot; margin" vertex="1">
          <mxGeometry height="44" width="220" x="1164" y="850" as="geometry" />
        </mxCell>
        <mxCell id="v18-callout-align-0403" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8ffe8;strokeColor=#228822;strokeWidth=1.8;opacity=100;dashed=0;fontColor=#145214;fontSize=6;" value="&lt;b&gt;★ v18 ALIGNMENT (x=11&#39;-6&quot;)&lt;/b&gt;&lt;br/&gt;Center pier A3/B3 lands at same x as&lt;br/&gt;center joist &amp; breaker board CL.&lt;br/&gt;Pier on girder (y=8&#39; or 16&#39;); joist runs y-dir." vertex="1">
          <mxGeometry height="52" width="180" x="590" y="513.4" as="geometry" />
        </mxCell>
        <mxCell id="v18-cj-callout-0116" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#804010;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#804010;fontSize=7;" value="&lt;b&gt;CENTER JOIST (v17 NEW)&lt;/b&gt;&lt;br/&gt;x=11&#39;-6&quot; framing  (x=11&#39;-9&quot; finish)&lt;br/&gt;2×10 PT UC4B — 2 segments&lt;br/&gt;LUS210Z hangers: ledger + mid-girder + outer-rim&lt;br/&gt;Provides bearing for center divider breaker" vertex="1">
