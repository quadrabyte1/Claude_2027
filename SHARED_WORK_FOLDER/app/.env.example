# SMTP configuration for the plaque emailer
# Copy this file to .env and fill in your values.
# Never commit .env — it contains credentials.

# Required — outbound SMTP server hostname
SMTP_HOST=smtp.example.com

# Optional — SMTP port (default: 587 for STARTTLS)
SMTP_PORT=587

# Required — SMTP login username (usually the sender email address)
SMTP_USER=you@example.com

# Required — SMTP login password or app-specific password
SMTP_PASS=your-password-here

# Optional — envelope From address (defaults to SMTP_USER if omitted)
SMTP_FROM=you@example.com

# Optional — recipient address for generated 3MF files (default: quadrabyte@pm.me)
SMTP_TO=quadrabyte@pm.me
